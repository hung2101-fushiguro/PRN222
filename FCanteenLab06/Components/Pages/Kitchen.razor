@page "/kitchen"
@rendermode InteractiveServer
@implements IDisposable
@using FCanteenLab06.Data
@using FCanteenLab06.Models
@using FCanteenLab06.Components.Shared
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<CanteenDbContext> Factory

<h3>Màn hình bếp</h3>
<p><i>Tự làm mới mỗi 5 giây. Đơn quá 10 phút viền đỏ.</i></p>

<div style="display:flex;gap:10px">
    @foreach (var s in new[] { OrderStatus.Pending, OrderStatus.Cooking, OrderStatus.Ready })
    {
        <div style="flex:1;background:#f8f8f8;padding:8px;border-radius:8px">
            <h4>@s (@Orders.Count(x => x.Status == s))</h4>
            @foreach (var o in Orders.Where(x => x.Status == s))
            {
                <OrderCard Order="o" OnAdvance="Advance" />
            }
        </div>
    }
</div>

@code {
    List<OrderTicket> Orders = new();
    Timer? timer;

    protected override async Task OnInitializedAsync()
    {
        await Load();
        timer = new Timer(async _ => { await Load(); await InvokeAsync(StateHasChanged); }, null, 5000, 5000);
    }

    async Task Load()
    {
        using var db = Factory.CreateDbContext();
        Orders = await db.OrderTickets.Include(x => x.Lines).ThenInclude(l => l.MenuItem)
            .Where(x => x.Status == OrderStatus.Pending || x.Status == OrderStatus.Cooking || x.Status == OrderStatus.Ready)
            .OrderBy(x => x.CreatedAt).ToListAsync();
    }

    async Task Advance(int id)
    {
        using var db = Factory.CreateDbContext();
        var o = await db.OrderTickets.FindAsync(id);
        if (o == null) return;
        var old = o.Status;
        o.Status = old switch
        {
            OrderStatus.Pending => OrderStatus.Cooking,
            OrderStatus.Cooking => OrderStatus.Ready,
            OrderStatus.Ready => OrderStatus.Served,
            _ => old
        };
        db.Histories.Add(new OrderStatusHistory
        {
            OrderTicketId = id,
            OldStatus = old,
            NewStatus = o.Status,
            ChangedBy = "Bep A",
            ChangedAt = DateTime.Now
        });
        await db.SaveChangesAsync();
        await Load();
    }

    public void Dispose() => timer?.Dispose();
}
